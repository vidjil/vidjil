!LAUNCH: $VIDJIL_DIR/$EXEC --all --out-reads -g $VIDJIL_DIR/germline/homo-sapiens-cd.g $VIDJIL_DATA/cd-19-trimmed.fa
!EXIT_CODE: 1

$ Load CD-sorting.fa
1:homo-sapiens/CD-sorting.fa .* 28 sequences

$ KmerSegmenter, do not map reads < 52bp
f1: UNSEG too short w .* 3 .*  50.0

$ KmerSegmenter, map reads and gather some reads, including a large clone
f1: found 9 windows in 23 reads
f1:Clone .* 13 reads

$ FineSegmenter, find 9 clones with CD19
f9:clone-.* CD19 .* SEG
