# ###
# This file contain all settable password and pass to change for running a vidjil server
# ###

# Configure back db access
MYSQL_ROOT_PASSWORD=mysql_root_password
MYSQL_PASSWORD=mysql_vidjil_password
MYSQL_BACKUP_PASSWORD=backup_password
MYSQL_DATABASE=vidjil
MYSQL_USER=vidjil

# Configure front address(es)
# FRONT_ADDRESS="localhost"
# Configure front DB address
# DB_ADDRESS="localhost"

# Metrics user
METRICS_USER_PASSWORD=foobartest
METRICS_USER_EMAIL=metrics@vidjil.org
METRICS_USER_FIRSTNAME=metrics
METRICS_USER_LASTNAME=instance

# Password to use for administration of py4web
PY4WEB_ADMIN_PASSWORD=py4web_admin_password

# Restic password to use
RESTIC_PASSWORD=restic_password

# Email configuration
# SMTP_SERVER="smtp.domain.org:587" # address of the SMTP server to use, with format "address:port"
# SMTP_CREDENTIALS="name@domain.org:password" # credentials to log in to SMTP server, with format "user:password"
# SMTP_FROM_EMAIL="name@domain.org" # from address to use when sending emails
# SMTP_DOMAIN="domain.org" # domain to use
# SMTP_ADMIN_EMAILS='["admin@domain.org"]' # list of email addresses to use when sending admin emails
# SMTP_EMAIL_SUBJECT_START="[Vidjil]" # subject prefix to use when sending emails
# SMTP_TLS=true # use TLS for SMTP connection (true/false) - default is true
# SMTP_SSL=false # use SSL for SMTP connection (true/false) - default is false

# Session/login configuration
# TWO_FACTOR_REQUIRED=false # if set to true, two-factor authentication is required. In this case, the email configuration is mandatory.
# TWO_FACTOR_LIST='[]' # 2 factor authentication list: white list if TWO_FACTOR_REQUIRED is true, black list otherwise.
# MAX_WRONG_PASSWORDS=5 # maximum number of wrong passwords before locking the account
# LOGIN_EXPIRATION_TIME=7200 # session expiration time in seconds - default is 7200 seconds (2 hours)
# SESSION_SECRET_KEY="<my secret key>" # secret key to use for session encryption

# Use to give a red color to prompt to make a warning
PRODUCTION=false

# Logs level to display in docker logs (use logging levels)
LOG_LEVEL="INFO"

# Is the platform healthcare compliant ? --> default is "false", set to "true" if compliant
# HEALTHCARE_COMPLIANCE="false"

# Server URL and version to display information
SERVER_URL="app.vidjil.org"
SERVER_VERSION="2024.12"

# Files for network import
# FILE_SOURCE="" # Directory to search for files for network import. If empty, the network import will not be available.
# FILE_TYPES='[".fastq", ".fastq.gz", ".fq", ".fq.gz"]' # list of file types to use for network import

# Limited accounts
# LIMITED_ACCOUNTS=[19]

# Change owner as user www-data (with docker, we only use this user by default)
# can take a while a first set if change is made on large amount of data. Can be set to false after a first call
CHANGE_OWNER=true

### Number of uwsgi threads to use (by default 6 if not declared)
### If you make some work on code, you can change it to 1 to get all threads similar when you relaunch application 
# UWSGI_POOL=1

### Workers pool can be set with value of WORKERS_POOL. If set to "false" (default), pool will be equal to number of available threads minus 1. 
### An automatic check and set will be done at launch to keep value not exceeding your number of threads minus 1.
### Set to 0 or do not set to get default pool number configuration (number of threads minus 1)
# WORKERS_POOL = 0
### Moreover, one can dedicate some workers to short running tasks, so that long running tasks do not suck up all resources.
### The other workers will deal with all sort of tasks (short or long).
### Set to 0 or do not set to get no workers specifically for short tasks.
# SHORT_JOBS_WORKERS_POOL = 0
### In this case, we set a task as a long running task if its sequence file is larger than a given size.
### Default value for this limit is 100Mo (100000000 o), and can be set with the following variable.
# CELERY_SIZE_LIMIT_FOR_LONG_JOB = 100000000
