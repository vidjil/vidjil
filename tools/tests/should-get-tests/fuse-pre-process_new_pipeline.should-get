
## Three available files:
# preprocess_before_new_pipeline.vidjil
# preprocess_new_pipeline_2024_12_fixed.vidjil
# preprocess_new_pipleine_2024_12_with_error.vidjil

# a vidjil file : ../../../algo/tests/data/results-two-clones-1-2.vidjil


################################
### Fuse with old preprocess
!OUTPUT_FILE: fuse_pre-process_old-vd-old.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_before_new_pipeline.vidjil ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_before_new_pipeline.vidjil  -o fuse_pre-process_old-vd-old.vidjil;

$ Fuse with one pre-process file; pre_process key
j: samples.pre_process


################################
### Fuse with old preprocess and bad new one
!OUTPUT_FILE: fuse_pre-process_old-vs-bad.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_before_new_pipeline.vidjil ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_new_pipleine_2024_12_with_error.vidjil  -o fuse_pre-process_old-vs-bad.vidjil;

$ Fuse with one pre-process file; pre_process key
j: samples.pre_process


################################
### Fuse with old preprocess and fixed new one
!OUTPUT_FILE: fuse_pre-process_old-vs-fixed.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_before_new_pipeline.vidjil ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_new_pipeline_2024_12_fixed.vidjil  -o fuse_pre-process_old-vs-fixed.vidjil;

$ Fuse with one pre-process file; pre_process key
j: samples.pre_process


################################
### Fuse with bad preprocess and fixed new one
!OUTPUT_FILE: fuse_pre-process_bad-vs-fixed.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_new_pipleine_2024_12_with_error.vidjil ../../../algo/tests/data/results-two-clones-1-2.vidjil,../data/preprocess_logs/preprocess_new_pipeline_2024_12_fixed.vidjil  -o fuse_pre-process_bad-vs-fixed.vidjil;

