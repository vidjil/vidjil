## Files
# ../data/analysis/sample_analysis_1.vidjil => 2 clusters
# ../data/analysis/sample_analysis_2.vidjil => 1 cluster, partally shared with previous file
# ../data/analysis/sample_without_analysis.vidjil => no analysis data
# ../data/analysis/sample_partial_analysis.vidjil => partial analysis content, no clusters values


### 2 files without analysis
!OUTPUT_FILE: fuse_analysiscase_without_analysis.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS  ../data/analysis/sample_without_analysis.vidjil ../data/analysis/sample_without_analysis.vidjil -o fuse_analysiscase_without_analysis.vidjil;

$ No analysis should be found
j: analysis
j: analysis.vidjil_json_version: ["2014.09"]
# j: analysis.clusters: []

### 2 files with analysis content, clusters with mix clonotype
!OUTPUT_FILE: fuse_analysiscase_with_analysis_both.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS  ../data/analysis/sample_analysis_1.vidjil ../data/analysis/sample_analysis_2.vidjil -o fuse_analysiscase_with_analysis_both.vidjil;

$ An analysis content should be found
j: analysis
$ Analysis cluster 1 content should be correct
j: analysis.clusters[0]: ["clone_shared_main", "clone_shared_sub2", "clone_shared_sub3", "clone_shared_sub4A", "clone_shared_sub4B"]
$ Analysis cluster 2 content should be correct
j: analysis.clusters[1]: ["clone_5A", "clone_6A"]

### 1 file with and 1 file without analysis content
!OUTPUT_FILE: fuse_analysiscase_mix_with_without_analysis.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS  ../data/analysis/sample_analysis_1.vidjil ../data/analysis/sample_without_analysis.vidjil -o fuse_analysiscase_mix_with_without_analysis.vidjil;

$ An analysis content should be found
j: analysis
$ Analysis cluster 1 content should be correct
j: analysis.clusters[0]: ["clone_shared_main", "clone_shared_sub2", "clone_shared_sub3", "clone_shared_sub4A", "clone_shared_sub4B"]
$ Analysis cluster 2 content should be correct
j: analysis.clusters[1]: ["clone_5A", "clone_6A"]

