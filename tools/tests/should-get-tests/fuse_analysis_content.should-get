### 1 file with clonotyp in cluster over limit
!OUTPUT_FILE: fuse_analysiscase_over_limit.vidjil
!LAUNCH: $PYTHON ../../fuse.py $FUSE_OPTIONS  ../data/analysis/sample_analysis_3_over.vidjil --top 10 -o fuse_analysiscase_over_limit.vidjil;

$ An analysis content should be found
j: analysis
$ Analysis cluster 1 content should be correct
j: analysis.clusters[0]: ["clone_shared_mainC", "clone_shared_sub3C", "clone_shared_sub4C"]
$ Analysis cluster 2 content should be correct
j: analysis.clusters[1]: ["clone_5C", "clone_6C"]
$ Analysis cluster 3 content should be correct
j: analysis.clusters[2]: ["clone_7C", "clone_9C"]

$ CLone 8 should not be retain as out limit, but clone 9, included in a cluster, should be keeped
j: clones[8]["id"]: "clone_9C"
